# Neon pooled connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate hashes with: npm run hash-password -- "your password"
CONTRIBUTOR_USERNAME=contributors
CONTRIBUTOR_PASSWORD_HASH=
ADMIN_USERNAME=admins
ADMIN_PASSWORD_HASH=

# Generate each with: openssl rand -base64 32
SESSION_SECRET=
WEBHOOK_ENCRYPTION_KEY=
CRON_SECRET=
RATE_LIMIT_SECRET=

# Optional shared cache. Connect Upstash Redis to the Vercel project and redeploy.
# Use the Free plan. Both values are server secrets (never NEXT_PUBLIC_*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Marketplace KV_REST_API_URL / KV_REST_API_TOKEN aliases are also supported.

# Optional /live Web Push. Generate once: npx web-push generate-vapid-keys
# Keep the private key secret and retain the same key pair across redeployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional. Passkeys use the request hostname as the relying-party ID; set this
# to pin a single domain (e.g. announcements.example.com).
PASSKEY_RP_ID=
